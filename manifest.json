{
  "manifest_version": 3,
  "name": "Ekşisözlük Görsel",
  "version": "1.0.0",
  "description": "Ekşisözlük görsellerini önizlemeleriyle birlikte görüntüleyin. EkşiUpload, ImgBB, Imgur ve Resmim desteği sunar.",
  "icons": {
    "16": "icons/icon-v3-16.png",
    "32": "icons/icon-v3-32.png",
    "48": "icons/icon-v3-48.png",
    "128": "icons/icon-v3-128.png"
  },
  "action": {
    "default_title": "Ekşisözlük Görsel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-v3-16.png",
      "32": "icons/icon-v3-32.png",
      "48": "icons/icon-v3-48.png",
      "128": "icons/icon-v3-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://ibb.co/*",
    "https://imgur.com/*",
    "https://resmim.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://eksisozluk.com/*",
        "https://www.eksisozluk.com/*"
      ],
      "js": [
        "urls.js",
        "html-fields.js",
        "providers/eksi.js",
        "providers/imgbb.js",
        "providers/imgur.js",
        "providers/resmim.js",
        "providers/direct.js",
        "providers/index.js",
        "transport.js",
        "scanner.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
